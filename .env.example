# LoyalTEA settings for Docker (Linux) or Vercel.
# Windows Server uses deploy/windows/loyaltea.env.example instead.

# --- Always needed ----------------------------------------------------------
# Long random string that signs staff sign-ins (32+ characters).
SESSION_SECRET=CHANGE_ME
# PINs, 6+ digits each, different from each other.
STAFF_PIN=CHANGE_ME
MANAGER_PIN=CHANGE_ME

# --- Optional ---------------------------------------------------------------
# Only allow the office Wi-Fi: comma-separated addresses or ranges, e.g. 10.20.0.0/16
ALLOWED_IPS=
# Stamps needed for a free drink (on Vercel call it NEXT_PUBLIC_STAMPS_FOR_REWARD)
STAMPS_FOR_REWARD=8

# --- Database: pick ONE -----------------------------------------------------
# a) Docker: the database is included. Just set its password (letters and numbers only).
POSTGRES_PASSWORD=CHANGE_ME
APP_PORT=3000
BACKUP_KEEP_DAYS=30

# b) An existing PostgreSQL server (Azure, etc.)
# DATABASE_URL=postgres://user:password@host:5432/loyaltea
# DATABASE_SSL=true

# c) Supabase (the current pilot on Vercel)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
