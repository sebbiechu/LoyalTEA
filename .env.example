# =============================================================================
# LoyalTEA configuration. Copy to .env (self-hosted) or enter in Vercel.
# Use ONE of the two database options.
# =============================================================================

# --- Shared by every setup -----------------------------------------------------
# Long random string that signs staff sessions. Generate: openssl rand -base64 48
SESSION_SECRET=change-me
# Shared PINs, 6+ digits, different from each other. Changing one signs out all devices using it.
STAFF_PIN=246810
MANAGER_PIN=13579135
# Stamps needed for a free drink (Vercel: name it NEXT_PUBLIC_STAMPS_FOR_REWARD)
STAMPS_FOR_REWARD=8
# Optional: only allow these IPs / ranges (comma separated), e.g. the office Wi-Fi.
# Blank = no restriction. See docs/IT-SETUP.md for which addresses to use.
ALLOWED_IPS=

# --- Option A: Self-hosted (docker compose) -------------------------------------
# Database password. Letters and numbers only (it is used inside a connection URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Port the app listens on, on the host
APP_PORT=3000
# How many days of daily backups to keep in ./backups
BACKUP_KEEP_DAYS=30
# Only for the optional built-in HTTPS (docker compose --profile https up -d)
DOMAIN=loyaltea.example.com
# Set to false ONLY for a plain-HTTP trial on an internal network (staff sign-in needs it)
COOKIE_SECURE=true

# --- Option B: Any existing PostgreSQL (e.g. Azure Database for PostgreSQL) -----
# DATABASE_URL=postgres://user:password@host:5432/loyaltea
# DATABASE_SSL=true

# --- Option C: Supabase (current Vercel setup) ----------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
