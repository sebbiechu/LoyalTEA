# Supabase project (Project Settings > API). The service role key stays on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string used to sign staff sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Shared PINs (6+ digits). Changing either one signs out every device using it.
STAFF_PIN=246810
MANAGER_PIN=13579135

# Stamps needed for a free drink
NEXT_PUBLIC_STAMPS_FOR_REWARD=8
