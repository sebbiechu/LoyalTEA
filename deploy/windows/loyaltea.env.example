# LoyalTEA settings for Windows Server.
# 1. Copy this file to C:\LoyalTEA\loyaltea.env
# 2. Fill in every value marked CHANGE ME
# install.ps1 locks the copied file so only Administrators can read it.

# Database connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Password: letters and numbers only.
DATABASE_URL=postgres://loyaltea:CHANGE_ME@localhost:5432/loyaltea

# Long random string that signs staff sign-ins. Generate one in PowerShell with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=CHANGE_ME

# PINs, 6+ digits each, different from each other.
# Staff PIN opens the till. Manager PIN also opens the reports.
STAFF_PIN=CHANGE_ME
MANAGER_PIN=CHANGE_ME

# Optional: only allow the office Wi-Fi. Comma-separated addresses or ranges, e.g. 10.20.0.0/16
# Leave blank to allow anyone who can reach the server.
ALLOWED_IPS=

# Port the app uses on this server. IIS forwards to it. Only change if 3000 is taken.
PORT=3000
